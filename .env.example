# ---- Uygulama ----
APP_NAME=OtelRadar
APP_ENV=development
APP_TZ=Europe/Istanbul
# Üretimde mutlaka uzun ve rastgele bir değer verin:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=degistirin-uzun-rastgele-bir-anahtar
SECURE_COOKIES=false

# ---- Veritabanı ----
# Docker Compose bunu otomatik ayarlar. Yerelde Docker'sız çalıştırmak için SQLite yeterlidir:
# DATABASE_URL=sqlite:///./data/app.db
DATABASE_URL=postgresql+psycopg2://otelradar:otelradar@localhost:5432/otelradar

# ---- İlk yönetici ----
ADMIN_EMAIL=admin@otelradar.local
ADMIN_PASSWORD=Admin123!

# ---- Veri kaynağı ----
# demo = sentetik veri (anahtar gerekmez), live = gerçek API'ler (anahtarı olmayan bileşen nötr kalır; sahte veri kullanılmaz)
DATA_PROVIDER=demo
HORIZON_DAYS=60
# Uygulama içi zamanlayıcı. Docker'da 'worker' servisi kullanıldığı için false bırakın.
SCHEDULER_ENABLED=false

# ---- Harici API anahtarları (docs/ACIK_KONULAR.md'deki teyitler tamamlanmadan canlıya almayın) ----
# Rakip fiyatı ve kalan oda (oda merdiveniyle alt sınır)
LITEAPI_KEY=
# İsteğe bağlı tarama kapsamı, ör. "Muğla:Bodrum,Marmaris;Antalya:Kemer" (boşsa varsayılan ilçe listesi)
LITEAPI_CITIES=
LITEAPI_MAX_HOTELS_PER_CITY=40
# Kalan oda merdiveni; boşsa kalan oda sorgulanmaz
LITEAPI_ROOM_LADDER=2,3,5,8
# Boş değilse yalnızca bu LiteAPI otel kimlikleri taranır (virgülle)
LITEAPI_HOTEL_IDS=
# Google Hotels fiyat takvimi: LiteAPI'de teklifi olmayan oteller için (kanal farkı düzeltilerek)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Uçuş talebi endeksi (Aviasales fiyat önbelleği)
TRAVELPAYOUTS_TOKEN=
# Google Hotels (şimdilik yalnızca doğrulama yoklamaları)
SERPAPI_KEY=
PREDICTHQ_TOKEN=
GOOGLE_MAPS_KEY=
# Belirsiz oda adları için (isteğe bağlı)
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
