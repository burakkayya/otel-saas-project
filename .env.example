# ---- Uygulama ----
APP_NAME=OtelRadar
APP_ENV=development
APP_TZ=Europe/Istanbul
# Üretimde mutlaka uzun ve rastgele bir değer verin:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=degistirin-uzun-rastgele-bir-anahtar
SECURE_COOKIES=false

# ---- Veritabanı ----
# Docker Compose bunu otomatik ayarlar. Yerelde Docker'sız çalıştırmak için SQLite yeterlidir:
# DATABASE_URL=sqlite:///./data/app.db
DATABASE_URL=postgresql+psycopg2://otelradar:otelradar@localhost:5432/otelradar

# ---- İlk yönetici ----
ADMIN_EMAIL=admin@otelradar.local
ADMIN_PASSWORD=Admin123!

# ---- Veri kaynağı ----
# demo = sentetik veri (anahtar gerekmez), live = gerçek API'ler (anahtarı olmayan bileşen demo'ya düşer)
DATA_PROVIDER=demo
HORIZON_DAYS=60
# Uygulama içi zamanlayıcı. Docker'da 'worker' servisi kullanıldığı için false bırakın.
SCHEDULER_ENABLED=false

# ---- Harici API anahtarları (docs/ACIK_KONULAR.md'deki teyitler tamamlanmadan canlıya almayın) ----
RAPIDAPI_KEY=
RAPIDAPI_HOTEL_PROVIDER=makcorps
RAPIDAPI_HOST=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
PREDICTHQ_TOKEN=
GOOGLE_MAPS_KEY=
FX_API_KEY=
# Belirsiz oda adları için (isteğe bağlı)
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
